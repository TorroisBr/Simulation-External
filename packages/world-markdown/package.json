{
  "name": "@simulation-external/world-markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Obsidian-friendly Markdown export and sync for Simulation world exchanges.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
